rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: publicly readable, writable
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: customers can create and read orders, admin can manage all
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Cafe settings and reservations
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /reservations/{resId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
